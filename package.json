{
  "name": "KairoPilot",
  "productName": "KairoPilot",
  "description": "A user-friendly desktop AI Agent application",
  "author": "墨香异境",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && electron-builder",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:regression": "vitest run .spec.ts",
    "smoke:native": "node scripts/p0-electron-smoke.mjs --unified",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node scripts/product-smoke.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run smoke",
    "preview": "vite preview",
    "postinstall": "install-electron && electron-builder install-app-deps"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@sentry/electron": "^7.13.0",
    "better-sqlite3": "13.0.3",
    "fix-path": "^5.0.0",
    "fs-extra": "^11.3.4",
    "lucide-react": "^0.577.0",
    "openai": "^6.29.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/fs-extra": "^11.0.4",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "^4.2.1",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "typescript": "^5.5.4",
    "vite": "7.3.7",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "5.0.5"
  },
  "main": "dist-electron/index.js",
  "engines": {
    "node": ">=24",
    "npm": ">=10"
  }
}
